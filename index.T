*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:#eef2f6;color:#1d2733}
header{background:#12355b;color:#fff;padding:16px 24px}h1{margin:0;font-size:24px}header p{margin:4px 0 0;font-size:13px;opacity:.85}
.kpi{display:flex;gap:12px;padding:14px 24px 0;flex-wrap:wrap}.k{background:#fff;border-radius:8px;padding:10px 16px;flex:1;min-width:150px;border-top:4px solid #2f78c4;box-shadow:0 1px 3px #0002}
.k b{display:block;font-size:22px;color:#12355b}.k span{font-size:12px;color:#555}
main{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:14px;padding:14px 24px}
.card{background:#fff;border-radius:8px;padding:12px 14px;box-shadow:0 1px 3px #0002}h2{font-size:14px;margin:0 0 8px;color:#12355b}
#map{width:100%;height:auto;background:#f3f1ea;border:1px solid #bbb;border-radius:6px}
.tog label{display:block;font-size:12.5px;margin:2px 0}.lg div{font-size:12px;margin:3px 0;display:flex;align-items:center;gap:6px}.lg i{display:inline-block;width:22px;height:10px;border:1px solid #666}
.b{display:grid;grid-template-columns:120px 1fr 52px;gap:6px;align-items:center;font-size:12px;margin:5px 0}.t{background:#e6ebf0;height:14px;border-radius:3px}.t div{height:14px;border-radius:3px}.b b{text-align:right}
ul{margin:0;padding-left:18px;font-size:13px}li{margin:4px 0}footer{padding:0 24px 18px;font-size:11.5px;color:#555}
table{border-collapse:collapse;width:100%;font-size:12px}td,th{border-bottom:1px solid #e1e6eb;padding:4px 6px;text-align:left}th{background:#e8eef4}
@media(max-width:900px){main{grid-template-columns:1fr}}</style></head><body>
